DATABASE_URL="postgres://username:password@host:port/db_name"
PORT=5000
DEFAULT_PAGE_SIZE=10
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=WO8l9QhhKEsdg7ZpgkR8A4qXNRtlrsCo
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=your_resend_api_key
SMTP_FROM_EMAIL=your_SMTP_email
SUPPORT_EMAIL=support@avatarindia.com

# Bunny.net Stream
BUNNY_API_KEY=your_bunny_api_key
BUNNY_LIBRARY_ID=your_bunny_library_id
BUNNY_CDN_HOSTNAME=your_pullzone_hostname.b-cdn.net
# Token key from Stream > Library > Security (used only when embed token auth is on)
BUNNY_TOKEN_SECURITY_KEY=your_bunny_token_authentication_key
# Set to "true" ONLY when "Embed view token authentication" is enabled in Bunny dashboard.
# Leave unset/false when only "CDN token authentication" is enabled (player signs CDN itself).
BUNNY_EMBED_TOKEN_AUTH=false

# MSG91 (phone verification widget)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_WIDGET_ID=your_msg91_widget_id
MSG91_TOKEN_AUTH=your_msg91_token_auth

# Payment provider: razorpay | cashfree
PAYMENT_PROVIDER=cashfree
BACKEND_URL=http://localhost:5000

# Razorpay (when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Webinar registration payment (always Razorpay, uses RAZORPAY_KEY_ID/SECRET above)
# Amount in paise. Optional — defaults to 700 (₹7) if unset.
WEBINAR_PRICE_PAISE=700
# WhatsApp community invite link (general, for interaction/networking), included in the payment confirmation email.
WHATSAPP_COMMUNITY_LINK=https://chat.whatsapp.com/your_invite_code
# WhatsApp group invite link for confirmed webinar attendees (joining link/updates for this batch).
WEBINAR_WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your_webinar_group_invite_code

# WhatsApp Cloud API (Meta) webhook — callback: <BACKEND_URL>/api/whatsapp/webhook. See WHATSAPP_WEBHOOK_SETUP.md.
# Everything stays disabled (webhook answers 503) unless WHATSAPP_ENABLED=true.
WHATSAPP_ENABLED=false
# Meta App Secret (App Dashboard > App settings > Basic). Used ONLY to verify X-Hub-Signature-256. Required when enabled.
WHATSAPP_APP_SECRET=your_meta_app_secret
# Any random string you choose; paste the same value in the Meta webhook form. Required when enabled.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_verify_token
# Permanent system-user access token (outbound Graph API calls only; the webhook itself does not use it).
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
# Business phone number ID (not the phone number). When set, events for other numbers are ignored.
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
# Graph API version for outbound calls (default v23.0).
WHATSAPP_GRAPH_API_VERSION=v23.0
# Business Admin inbox replies: nothing is ever SENT unless this is exactly "true" (receiving never needs it).
# Also needs WHATSAPP_ENABLED=true, WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID.
WHATSAPP_OUTBOUND_ENABLED=false

# Cashfree (when PAYMENT_PROVIDER=cashfree)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
CASHFREE_ENV=sandbox
# Google Sign-In (OAuth 2.0 Client ID, "Web application" type)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Google Sheets (service account — secondary reporting sync for Users / Leads)
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Pabbly webhooks — fire on successful purchase / signup to log to Excel +
# send WhatsApp notification. Leave unset to disable.
# PABBLY_D2H_PURCHASE_WEBHOOK_URL         — D2H ₹4999 + assessment/counselling
# PABBLY_BASIC_COURSE_PURCHASE_WEBHOOK_URL — ₹499 Basic course purchases
PABBLY_D2H_PURCHASE_WEBHOOK_URL=your_pabbly_d2h_purchase_webhook_url
PABBLY_BASIC_COURSE_PURCHASE_WEBHOOK_URL=your_pabbly_basic_course_purchase_webhook_url
PABBLY_SIGNUP_WEBHOOK_URL=your_pabbly_signup_webhook_url

# Business Admin (/admin-adaption): comma-separated emails of ADMIN users who may open it. SUPERADMIN always can.
# Leave empty to allow SUPERADMIN only.
BUSINESS_ADMIN_EMAILS=

# DEV ONLY: sandbox test login for /admin-adaption (in-memory fake data, no database, no real WhatsApp).
# Active only when NODE_ENV=development AND DEV_TEST_LOGIN=true AND a password is set. Never set these in production.
# Login email is fixed in code (adaption.test@localhost.test); the password is whatever you choose here.
DEV_TEST_LOGIN=
DEV_TEST_LOGIN_PASSWORD=   # quote the value if it contains a #

# Business Admin website analytics (Microsoft Clarity Data Export API). Both optional; analytics shows 'not connected' without the token.
# Create the token in Clarity: Settings > Data Export. The project id is only used to build links to the Clarity dashboard.
CLARITY_API_TOKEN=
CLARITY_PROJECT_ID=

# WhatsApp Template Manager / automation (all optional, all OFF by default).
# WHATSAPP_APP_ID: Meta app id; only needed to upload sample images/videos/documents for template headers.
WHATSAPP_APP_ID=
# Master switch for AUTOMATIC sending (needs WHATSAPP_ENABLED and WHATSAPP_OUTBOUND_ENABLED too). Anything but "true" = nothing is ever sent
# automatically: events are only recorded as skipped. Read at boot for the queue worker.
WHATSAPP_AUTOMATION_ENABLED=false

# Email Automation (Integrations page → Email Automation). Reuses RESEND_API_KEY / SMTP_FROM_EMAIL above.
# Master switch for AUTOMATIC and SCHEDULED sending + the queue worker (read at boot). Anything but "true" = only manual "send now" and test emails work.
EMAIL_AUTOMATION_ENABLED=false
# Resend → Webhooks → signing secret (whsec_...). Without it delivery/bounce updates are refused (503). Webhook URL: <BACKEND_URL>/api/email-automation/webhook
RESEND_WEBHOOK_SECRET=
# Signs unsubscribe links. Falls back to JWT_SECRET when empty. Promotional email is refused if neither (or BACKEND_URL) is set.
EMAIL_UNSUBSCRIBE_SECRET=
# Sender display name (the address is SMTP_FROM_EMAIL). Default: Avatar AI Adoption
EMAIL_AUTOMATION_FROM_NAME=
