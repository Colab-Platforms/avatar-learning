### Set these locally — do not commit real Pabbly URLs
@d2hPurchaseWebhookUrl = REPLACE_WITH_PABBLY_D2H_PURCHASE_WEBHOOK_URL
@basicCoursePurchaseWebhookUrl = REPLACE_WITH_PABBLY_BASIC_COURSE_PURCHASE_WEBHOOK_URL
@signupWebhookUrl = REPLACE_WITH_PABBLY_SIGNUP_WEBHOOK_URL

### Purchase webhook (D2H ₹4999)

POST {{d2hPurchaseWebhookUrl}}
Content-Type: application/json

{
  "customer_name": "John Doe",
  "phone_number": "91NUMBER",
  "email": "JOHN.DOE@EXAMPLE.COM",
  "product_name": "Direct2Hire Programme",
  "amount": 4999,
  "order_id": "order_TSNMNjAbWKnf0C",
  "payment_id": "pay_TSNMSWbzKsy7Oz",
  "purchase_date": "2026-08-21T09:48:33.366Z"
}

