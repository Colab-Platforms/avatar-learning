# Backend API base URL. Set it per Vercel environment: Production = the production API, Preview = a DEVELOPMENT API.
# A Vercel Preview build fails if this is missing or points at the production API (see client/lib/apiBaseCheck.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Google Sign-In (OAuth 2.0 Client ID, "Web application" type — must match backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Dev-only: bypass Direct2Hire sidebar step-lock (Assessment -> Counselling -> AI Learning -> Internships -> Job Placement).
# Leave unset/false in production.
NEXT_PUBLIC_D2H_DEV_UNLOCK=false

# Microsoft Clarity project id for the PUBLIC website tag (loaded only on public pages, only after the visitor accepts).
# Leave unset to keep using the existing project.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Live Monitoring: first-party visit tracking requires the visitor's analytics consent (the cookie-banner choice). Set to false ONLY if counsel confirms consent is not required; a refusal is still honoured.
NEXT_PUBLIC_TRACKING_REQUIRE_CONSENT=true
