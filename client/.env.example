# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Google Sign-In (OAuth 2.0 Client ID, "Web application" type — must match backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Dev-only: bypass Direct2Hire sidebar step-lock (Assessment -> Counselling -> AI Learning -> Internships -> Job Placement).
# Leave unset/false in production.
NEXT_PUBLIC_D2H_DEV_UNLOCK=false
